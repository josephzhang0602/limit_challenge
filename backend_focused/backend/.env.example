# Copy this file to .env to change a value. Without a .env file the project
# runs with the development defaults.

# Turn off outside of development. DJANGO_SECRET_KEY is then required.
DJANGO_DEBUG=true

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEBUG, INFO, WARNING or ERROR.
DJANGO_LOG_LEVEL=INFO

# Requests allowed for each client, as number/period.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/min
THROTTLE_LOGIN=10/min

# Password of the demo users that seed_fleet creates.
SEED_USER_PASSWORD=fleet-demo-2026
